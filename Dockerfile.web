FROM node:22-alpine AS build
WORKDIR /app
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY src ./src
COPY vendor/casa-agent/src/radicale.mjs vendor/casa-agent/src/dates.mjs ./vendor/casa-agent/src/
COPY vite.web.config.js ./
RUN npm run build:web

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production PORT=3000 TZ=Europe/Madrid
COPY --from=build --chown=node:node /app/dist ./dist
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD node -e "fetch('http://127.0.0.1:3000/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/server/index.mjs"]
