{
  "name": "calendar-personal-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "build:reminders-helper": "zsh native/reminders-helper/build-app.sh",
    "package:mac": "npm run build:reminders-helper && npm run build && electron-builder --mac dir && zsh scripts/sign-local-mac.sh",
    "build:web": "vite build --config vite.web.config.js && vite build --config vite.web.config.js --mode server",
    "start:web": "node dist/server/index.mjs",
    "test": "node scripts/test-unit.mjs",
    "test:integration": "node --test test/reminders.integration.test.mjs"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@wordpress/components": "^30.0.0",
    "@wordpress/icons": "^10.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "electron-store": "^10.0.0",
    "google-auth-library": "^9.15.0",
    "googleapis": "^144.0.0",
    "openid-client": "6.8.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^33.4.11",
    "electron-builder": "^26.0.12",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.juanmagarrido.unified-calendar",
    "productName": "Unified Calendar",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/reminders-helper/.build/release/RemindersHelper.app",
        "to": "reminders/RemindersHelper.app"
      },
      {
        "from": ".env",
        "to": "config/.env"
      }
    ],
    "mac": {
      "target": "dir",
      "icon": "assets/icon.png",
      "extendInfo": {
        "NSRemindersFullAccessUsageDescription": "Unified Calendar reads your reminders so it can show them alongside your Google Calendar and Trello events.",
        "NSRemindersUsageDescription": "Unified Calendar reads your reminders so it can show them alongside your Google Calendar and Trello events."
      }
    }
  }
}
