# Copy to .env (gitignored) and fill in with credentials from a Google Cloud
# OAuth client of type "Desktop app" (https://console.cloud.google.com/apis/credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated labels for each Google account you want to connect, e.g. "personal,work".
# One OAuth consent flow runs per label; tokens are stored separately per label.
GOOGLE_ACCOUNTS=default

# Get a Trello API key at https://trello.com/power-ups/admin, then generate a
# token by visiting: https://trello.com/1/authorize?expiration=never&scope=read&response_type=token&key=YOUR_KEY
TRELLO_API_KEY=
TRELLO_TOKEN=

# Optional: comma-separated Trello board IDs to limit which boards are polled.
# Leave blank to pull cards from every open board the token can see.
TRELLO_BOARD_IDS=
