# Copy to .env (gitignored) and fill in with credentials from a Google Cloud
# OAuth client of type "Desktop app" (https://console.cloud.google.com/apis/credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional legacy account labels. New accounts should be added from
# Settings → Connections → Connect another account.
GOOGLE_ACCOUNTS=

# Get a Trello API key at https://trello.com/power-ups/admin, then generate a
# token by visiting: https://trello.com/1/authorize?expiration=never&scope=read,write&response_type=token&key=YOUR_KEY
# (read,write — 'write' is required to move a card's due date from the calendar)
TRELLO_API_KEY=
TRELLO_TOKEN=

# Optional: comma-separated Trello board IDs to limit which boards are polled.
# Leave blank to pull cards from every open board the token can see.
TRELLO_BOARD_IDS=

# Wallos self-hosted subscription tracker. Get your API key from
# Wallos → Settings → API Key.
WALLOS_BASE_URL=
WALLOS_API_KEY=

# Linear personal API key. Generate one at
# Linear → Settings → Security & access → Personal API keys.
LINEAR_API_KEY=

# Optional: comma-separated team keys (e.g. LOBE,BIF) to limit which teams'
# issues are pulled. Leave blank to pull from every team you have issues in.
LINEAR_TEAM_KEYS=
